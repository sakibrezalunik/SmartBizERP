@model IEnumerable<SmartBizERP.Models.StockTransaction>

@{ ViewBag.Title = "Stock Ledger"; }

<h2>Stock Ledger</h2>
<p class="text-muted">Showing the most recent 200 transactions.</p>

<div class="mb-3">
    @Html.ActionLink("Back to Stock Overview", "Index", null, new { @class = "btn btn-default" })
</div>

<form method="get" class="d-flex gap-2 mb-3">
    @Html.DropDownList("productId", (SelectList)ViewBag.ProductList, "-- All Products --", new { @class = "form-control" })
    @Html.DropDownList("warehouseId", (SelectList)ViewBag.WarehouseList, "-- All Warehouses --", new { @class = "form-control" })
    <button type="submit" class="btn btn-secondary">Filter</button>
    <a href="@Url.Action("Ledger")" class="btn btn-link">Clear</a>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Date</th>
            <th>Product</th>
            <th>Warehouse</th>
            <th>Type</th>
            <th>Quantity</th>
            <th>Reference</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.TransactionDate.ToString("yyyy-MM-dd HH:mm")</td>
            <td>@item.Product.ProductName</td>
            <td>@item.Warehouse.WarehouseName</td>
            <td>
                @{
                    string badgeClass = item.TransactionType == "PURCHASE" ? "bg-success"
                        : item.TransactionType == "SALE" ? "bg-danger"
                        : item.TransactionType == "TRANSFER" ? "bg-info"
                        : "bg-secondary";
                }
                <span class="badge @badgeClass">@item.TransactionType</span>
            </td>
            <td class="@(item.Quantity < 0 ? "text-danger" : "text-success")">
                @(item.Quantity > 0 ? "+" : "")@item.Quantity.ToString("N2")
            </td>
            <td>@item.ReferenceType</td>
        </tr>
    }
    </tbody>
</table>
