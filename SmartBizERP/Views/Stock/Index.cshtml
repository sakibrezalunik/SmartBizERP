@model IEnumerable<SmartBizERP.Models.WarehouseStock>

@{ ViewBag.Title = "Warehouse Stock"; }

<h2>Warehouse Stock</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="mb-3">
    @Html.ActionLink("Stock Ledger", "Ledger", null, new { @class = "btn btn-info" })
    @Html.ActionLink("Stock Adjustment", "Adjustment", null, new { @class = "btn btn-warning" })
    @Html.ActionLink("Transfer Stock", "Transfer", null, new { @class = "btn btn-primary" })
</div>

<form method="get" class="d-flex gap-2 mb-3">
    @Html.DropDownList("warehouseId", (SelectList)ViewBag.WarehouseList, "-- All Warehouses --", new { @class = "form-control" })
    @Html.DropDownList("productId", (SelectList)ViewBag.ProductList, "-- All Products --", new { @class = "form-control" })
    <button type="submit" class="btn btn-secondary">Filter</button>
    <a href="@Url.Action("Index")" class="btn btn-link">Clear</a>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Warehouse</th>
            <th>Product</th>
            <th>Quantity on Hand</th>
            <th>Reorder Level</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr class="@(item.Quantity <= item.Product.ReorderLevel ? "table-danger" : "")">
            <td>@item.Warehouse.WarehouseName</td>
            <td>@item.Product.ProductName</td>
            <td>@item.Quantity.ToString("N2")</td>
            <td>@item.Product.ReorderLevel.ToString("N2")</td>
            <td>
                @if (item.Quantity <= item.Product.ReorderLevel)
                {
                    <span class="badge bg-danger">Low Stock</span>
                }
                else
                {
                    <span class="badge bg-success">OK</span>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
