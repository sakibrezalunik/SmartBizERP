@model IEnumerable<SmartBizERP.Models.Category>

@{ ViewBag.Title = "Categories"; }

<h2>Categories</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<p>@Html.ActionLink("+ Create New Category", "Create", null, new { @class = "btn btn-primary" })</p>

<form method="get" class="d-flex gap-2 mb-3">
    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search categories..." />
    <button type="submit" class="btn btn-secondary">Search</button>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr><th>Name</th><th>Description</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.CategoryName</td>
            <td>@item.Description</td>
            <td>
                @if (item.IsActive) { <span class="badge bg-success">Active</span> }
                else { <span class="badge bg-secondary">Inactive</span> }
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.CategoryId }, new { @class = "btn btn-sm btn-warning" })
                @Html.ActionLink("Delete", "Delete", new { id = item.CategoryId }, new { @class = "btn btn-sm btn-danger" })
            </td>
        </tr>
    }
    </tbody>
</table>
