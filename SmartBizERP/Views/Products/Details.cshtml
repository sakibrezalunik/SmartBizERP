@model SmartBizERP.Models.Product

@{
    ViewBag.Title = "Product Details";
}

<h2>Product Details</h2>

<dl class="dl-horizontal">
    <dt>Code</dt>
    <dd>@Model.ProductCode</dd>

    <dt>Name</dt>
    <dd>@Model.ProductName</dd>

    <dt>Category</dt>
    <dd>@Model.Category.CategoryName</dd>

    <dt>Unit</dt>
    <dd>@Model.Unit.UnitName</dd>

    <dt>Cost Price</dt>
    <dd>@Model.CostPrice.ToString("N2")</dd>

    <dt>Selling Price</dt>
    <dd>@Model.SellingPrice.ToString("N2")</dd>

    <dt>Reorder Level</dt>
    <dd>@Model.ReorderLevel</dd>

    <dt>Status</dt>
    <dd>@(Model.IsActive ? "Active" : "Inactive")</dd>
</dl>

@Html.ActionLink("Edit", "Edit", new { id = Model.ProductId }, new { @class = "btn btn-warning" })
@Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-default" })
