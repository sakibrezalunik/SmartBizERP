@model SmartBizERP.Models.Product

@{
    ViewBag.Title = "Delete Product";
}

<h2>Delete Product</h2>

<div class="alert alert-warning">
    Are you sure you want to deactivate this product?
</div>

<dl class="dl-horizontal">
    <dt>Code</dt>
    <dd>@Model.ProductCode</dd>

    <dt>Name</dt>
    <dd>@Model.ProductName</dd>

    <dt>Category</dt>
    <dd>@Model.Category.CategoryName</dd>
</dl>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Yes, Deactivate</button>
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
}
