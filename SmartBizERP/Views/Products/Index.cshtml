@model IEnumerable<SmartBizERP.Models.Product>

@{
    ViewBag.Title = "Products";
}

<h2>Products</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<p>
    @Html.ActionLink("+ Create New Product", "Create", null, new { @class = "btn btn-primary" })
</p>

<form method="get" action="@Url.Action("Index")" class="form-inline" style="margin-bottom: 15px;">
    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search by name or code..." />

    @Html.DropDownList("categoryId", (SelectList)ViewBag.CategoryList, "-- All Categories --", new { @class = "form-control" })

    <button type="submit" class="btn btn-default">Search</button>
    <a href="@Url.Action("Index")" class="btn btn-link">Clear</a>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Category</th>
            <th>Unit</th>
            <th>Cost Price</th>
            <th>Selling Price</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ProductCode</td>
            <td>@item.ProductName</td>
            <td>@item.Category.CategoryName</td>
            <td>@item.Unit.UnitName</td>
            <td>@item.CostPrice.ToString("N2")</td>
            <td>@item.SellingPrice.ToString("N2")</td>
            <td>
                @if (item.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </td>
            <td>
                @Html.ActionLink("Details", "Details", new { id = item.ProductId }, new { @class = "btn btn-sm btn-info" })
                @Html.ActionLink("Edit", "Edit", new { id = item.ProductId }, new { @class = "btn btn-sm btn-warning" })
                @Html.ActionLink("Delete", "Delete", new { id = item.ProductId }, new { @class = "btn btn-sm btn-danger" })
            </td>
        </tr>
    }
    </tbody>
</table>

@if (ViewBag.TotalPages > 1)
{
    <ul class="pagination">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="@(i == ViewBag.CurrentPage ? "active" : "")">
                @Html.ActionLink(i.ToString(), "Index", new { page = i, searchTerm = ViewBag.SearchTerm })
            </li>
        }
    </ul>
}
