@model IEnumerable<SmartBizERP.Models.SalesOrder>

@{ ViewBag.Title = "Sales Report"; }

<h2>Sales Report</h2>
<p class="text-muted">Delivered orders only.</p>

<table class="table table-striped table-bordered">
    <thead><tr><th>SO No.</th><th>Customer</th><th>Date</th><th>Total</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.SalesOrderNo</td>
            <td>@item.Customer.CustomerName</td>
            <td>@item.OrderDate.ToString("yyyy-MM-dd")</td>
            <td>@item.TotalAmount.ToString("N2")</td>
        </tr>
    }
    </tbody>
    <tfoot>
        <tr><th colspan="3" class="text-end">Grand Total</th><th>@(((decimal)ViewBag.GrandTotal).ToString("N2"))</th></tr>
    </tfoot>
</table>

@Html.ActionLink("Back to Reports", "Index", null, new { @class = "btn btn-default" })
