@{ ViewBag.Title = "Profit Report"; }

<h2>Profit Report</h2>
<p class="text-muted">Delivered sales lines only.</p>

<table class="table table-striped table-bordered">
    <thead><tr><th>SO No.</th><th>Date</th><th>Product</th><th>Qty</th><th>Revenue</th><th>Profit</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.SalesOrderNo</td>
            <td>@item.OrderDate.ToString("yyyy-MM-dd")</td>
            <td>@item.ProductName</td>
            <td>@item.Quantity.ToString("N2")</td>
            <td>@item.Revenue.ToString("N2")</td>
            <td class="@(item.Profit >= 0 ? "text-success" : "text-danger")">@item.Profit.ToString("N2")</td>
        </tr>
    }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="4" class="text-end">Totals</th>
            <th>@(((decimal)ViewBag.TotalRevenue).ToString("N2"))</th>
            <th>@(((decimal)ViewBag.TotalProfit).ToString("N2"))</th>
        </tr>
    </tfoot>
</table>

@Html.ActionLink("Back to Reports", "Index", null, new { @class = "btn btn-default" })
