@model SmartBizERP.Models.User

@{ ViewBag.Title = "Edit User"; }

<h2>Edit User: @Model.Username</h2>

<form method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="userId" value="@Model.UserId" />

    <div class="form-group">
        <label>Full Name</label>
        <input type="text" name="fullName" value="@Model.FullName" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Email</label>
        <input type="email" name="email" value="@Model.Email" class="form-control" />
    </div>

    <div class="form-check mb-3">
        <input type="checkbox" name="isActive" value="true" class="form-check-input" id="isActive" @(Model.IsActive ? "checked" : "") />
        <label class="form-check-label" for="isActive">Active</label>
    </div>

    <div class="form-group">
        <label>Roles</label>
        @{ var selectedIds = (List<int>)ViewBag.SelectedRoleIds; }
        @foreach (var role in (List<SmartBizERP.Models.Role>)ViewBag.Roles)
        {
            <div class="form-check">
                <input type="checkbox" name="roleIds" value="@role.RoleId" class="form-check-input" id="role_@role.RoleId" @(selectedIds.Contains(role.RoleId) ? "checked" : "") />
                <label class="form-check-label" for="role_@role.RoleId">@role.RoleName - @role.Description</label>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary mt-2">Save</button>
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
</form>
