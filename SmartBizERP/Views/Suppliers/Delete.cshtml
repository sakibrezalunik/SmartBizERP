@model SmartBizERP.Models.Supplier

@{ ViewBag.Title = "Delete Supplier"; }

<h2>Delete Supplier</h2>

<div class="alert alert-warning">Are you sure you want to deactivate this supplier?</div>

<dl class="dl-horizontal">
    <dt>Code</dt><dd>@Model.SupplierCode</dd>
    <dt>Name</dt><dd>@Model.SupplierName</dd>
    <dt>Phone</dt><dd>@Model.Phone</dd>
</dl>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Yes, Deactivate</button>
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
}
