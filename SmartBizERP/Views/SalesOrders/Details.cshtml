@model SmartBizERP.Models.SalesOrder

@{ ViewBag.Title = "Sales Order " + Model.SalesOrderNo; }

<h2>Sales Order @Model.SalesOrderNo</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<dl class="dl-horizontal">
    <dt>Customer</dt><dd>@Model.Customer.CustomerName</dd>
    <dt>Warehouse</dt><dd>@Model.Warehouse.WarehouseName</dd>
    <dt>Date</dt><dd>@Model.OrderDate.ToString("yyyy-MM-dd")</dd>
    <dt>Status</dt>
    <dd>
        @if (Model.Status == "Delivered")
        {
            <span class="badge bg-success">Delivered</span>
        }
        else
        {
            <span class="badge bg-secondary">Draft</span>
        }
    </dd>
</dl>

<h4>Line Items</h4>
<table class="table table-bordered">
    <thead><tr><th>Product</th><th>Qty</th><th>Unit Price</th><th>Total</th></tr></thead>
    <tbody>
    @foreach (var line in Model.SalesOrderDetails)
    {
        <tr>
            <td>@line.Product.ProductName</td>
            <td>@line.Quantity.ToString("N2")</td>
            <td>@line.UnitPrice.ToString("N2")</td>
            <td>@line.TotalAmount.ToString("N2")</td>
        </tr>
    }
    </tbody>
    <tfoot>
        <tr><th colspan="3" class="text-end">Grand Total</th><th>@Model.TotalAmount.ToString("N2")</th></tr>
    </tfoot>
</table>

@if (Model.Status == "Draft")
{
    <h4>Add Line Item</h4>
    <form action="@Url.Action("AddLine", "SalesOrders")" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="salesOrderId" value="@Model.SalesOrderId" />

        <div class="row">
            <div class="col-md-4">
                @Html.DropDownList("productId", (SelectList)ViewBag.ProductId, "-- Select Product --", new { @class = "form-control" })
            </div>
            <div class="col-md-3">
                <input type="number" step="0.01" name="quantity" placeholder="Quantity" class="form-control" required />
            </div>
            <div class="col-md-3">
                <input type="number" step="0.01" name="unitPrice" placeholder="Unit Price" class="form-control" required />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-secondary w-100">Add</button>
            </div>
        </div>
    </form>

    <div class="mt-3">
        @if (Model.SalesOrderDetails.Any())
        {
            <form action="@Url.Action("Deliver", "SalesOrders")" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.SalesOrderId" />
                <button type="submit" class="btn btn-success">Deliver Order (reduces stock)</button>
            </form>
        }
    </div>
}

<p class="mt-3">@Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-default" })</p>
