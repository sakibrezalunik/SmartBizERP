@{ ViewBag.Title = "New Purchase Order"; }

<h2>New Purchase Order</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label>Supplier</label>
        @Html.DropDownList("supplierId", (SelectList)ViewBag.SupplierId, "-- Select Supplier --", new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Warehouse (goods will be received into this warehouse)</label>
        @Html.DropDownList("warehouseId", (SelectList)ViewBag.WarehouseId, "-- Select Warehouse --", new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-primary mt-2">Create Order</button>
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
}
